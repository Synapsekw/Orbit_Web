# Reference only. Add real values in Netlify's UI, production context, Functions scope.
# Never commit a populated copy or put these variables in public JavaScript.
ORBI_ENABLED=false
# Workstation only. Real Grok handoff tests need their own explicit activation.
ORBI_LOCAL_ENABLED=false
ORBI_LOCAL_CALLBACKS_ENABLED=false
OPENAI_API_KEY=
ORBI_SESSION_SECRET=
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
# Optional: if entered, must match "Bearer " followed by GROKBOT_WEBHOOK_KEY.
GROKBOT_AUTHORIZATION_HEADER=

ORBI_MODEL=gpt-6-luna
ORBI_PROVIDER_ENDPOINT=https://api.openai.com/v1/chat/completions
ORBI_REASONING_EFFORT=none
ORBI_STRUCTURED_OUTPUTS=true
ORBI_TOKEN_PARAMETER=max_completion_tokens
ORBI_OUTPUT_TOKENS=1600
ORBI_ALLOWED_ORIGINS=https://www.orbitaerials.com,https://orbitaerials.com
ORBI_CALLBACKS_ENABLED=true
ORBI_LIMIT_PER_MINUTE=8
ORBI_LIMIT_PER_HOUR=60
ORBI_LIMIT_PER_DAY=200
# Netlify provisions NETLIFY_DB_URL. Do not copy the database URL to browser code.
