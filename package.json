{
  "name": "orbit-spatial-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.js tests/netlify/*.test.mjs",
    "prepare:scan": "node scripts/prepare-scan.mjs",
    "pages": "node scripts/journal.mjs && node scripts/build-site.mjs && node scripts/build-orbi-knowledge.mjs",
    "prepare:media": "node scripts/prepare-site-media.mjs",
    "prebuild": "npm run pages",
    "predev": "npm run pages",
    "check:public": "node scripts/check-public.mjs",
    "check:repo": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@netlify/database": "^2.0.1",
    "marked": "^17.0.6",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  }
}
